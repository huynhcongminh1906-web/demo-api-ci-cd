          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"Tạo booking thành công\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Kiểm tra tên khách hàng\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.booking.firstname).to.eql(\"Cong Minh\");\n});\n\npm.test(\"Kiểm tra tổng giá trị đặt phòng\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.booking.totalprice).to.eql(1500);\n});\n\npm.test(\"Booking ID được tạo hợp lệ\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.bookingid).to.be.a(\"number\");\n});\n\n// Lưu ID để sử dụng ở Request 3\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingid\", jsonData.bookingid);\n"
                ]
              }
            }
          ],
