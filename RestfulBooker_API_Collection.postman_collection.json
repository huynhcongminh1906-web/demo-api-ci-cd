            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\n{\n  \"firstname\": \"Cong Minh\",\n  \"lastname\": \"Huynh\",\n  \"totalprice\": 1500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}\n",
